# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 절대 커밋하지 마세요)

# [필수] Anthropic API 키 — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 화면 상단에 표시할 기관명
NEXT_PUBLIC_ORG_NAME=○○증권 리서치센터

# 자비스를 팝업(iframe)으로 띄울 수 있는 홈페이지 주소 (여러 개면 띄어쓰기로 구분)
EMBED_ALLOWED_ORIGINS=https://research.example.com

# 비용 보호 — 방문자 1명(IP)당 10분에 새 조사 몇 번까지, 하루 전체 새 조사 상한
RATE_LIMIT_PER_10MIN=20
DAILY_RESEARCH_LIMIT=500

# 같은 질문 답변을 다시 쓰는 시간(시간 단위). 시장 정보라 짧게.
CACHE_TTL_HOURS=6

# 모델 (기본값 그대로 써도 됩니다)
# JARVIS_BRIEF_MODEL=claude-sonnet-5-5   # 카드(차트·출처) 작성
# JARVIS_QUICK_MODEL=claude-haiku-4-5    # 2~4초 안에 먼저 말하는 답
# JARVIS_ROUTER_MODEL=claude-haiku-4-5   # 인사·잡담 판단
